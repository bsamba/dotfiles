
# GitHub Actions Runner Tokens
# Generate org-level tokens using:
# gh auth refresh -h github.com -s admin:org
# gh api orgs/n3otech/actions/runners/registration-token --method POST --jq '.token'
#
# Tokens expire in 1 hour after generation - use them immediately after copying to .env
#
# SECURITY WARNING: Never commit the .env file with real tokens to git!

# Heavy Runners (5GB RAM, 3 CPU for runner; 3GB RAM, 1 CPU for DinD)
RUNNER_TOKEN_001=YOUR_TOKEN_HERE
RUNNER_TOKEN_002=YOUR_TOKEN_HERE

# Runner Names (registered on GitHub):
# - n3o0x65lnxrun001
# - n3o0x65lnxrun002

# Quick Start:
# 1. Copy this file to .env: cp example.env .env
# 2. Generate org tokens: gh api orgs/n3otech/actions/runners/registration-token --method POST --jq '.token'
# 3. Replace YOUR_TOKEN_HERE with actual tokens (use within 1 hour)
# 4. Set secure permissions: chmod 600 .env
# 5. Deploy: docker compose up -d
